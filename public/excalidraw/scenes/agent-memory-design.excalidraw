    {
      "id": "rbb6PSFzmwxgWM3lJrqfI",
      "type": "text",
      "x": 441.02423463859554,
      "y": 6111.0604937394155,
      "width": 636.279541015625,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
