      "versionNonce": 1863484443,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756296734234,
      "link": null,
      "locked": false,
      "text": "Universal backend map:\n\nEdge/CDN (cache, TLS, WAF, edge functions)\n→ API Gateway (auth/rate-limit/routing) \n→ Services (Orders, Billing, Inventory, Search,\nTickets) \n→ Datastores (RDBMS/Cache/Blob) +\nQueues/Workers \n→ Observability.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Universal backend map:\n\nEdge/CDN (cache, TLS, WAF, edge functions)\n→ API Gateway (auth/rate-limit/routing) \n→ Services (Orders, Billing, Inventory, Search, Tickets) \n→ Datastores (RDBMS/Cache/Blob) + Queues/Workers \n→ Observability.",
      "autoResize": false,
      "lineHeight": 1.25
    },
