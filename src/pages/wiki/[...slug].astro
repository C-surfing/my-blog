---
import { getCollection, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";

import { formatDateToYYYYMMDD } from "../../utils/date-utils";

export async function getStaticPaths() {
	const wikiEntries = await getCollection("wiki");
	return wikiEntries.map((entry) => ({
		params: { slug: entry.id.replace(/\.(md|mdx)$/, "") },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allEntries = await getCollection("wiki");
const siblings = allEntries
	.filter((e) => (e.data.category || "其他") === (entry.data.category || "其他"))
	.sort((a, b) => a.data.title.localeCompare(b.data.title, "zh"));
const currentIndex = siblings.findIndex((e) => e.id === entry.id);
const prevEntry = currentIndex > 0 ? siblings[currentIndex - 1] : null;
const nextEntry =
	currentIndex >= 0 && currentIndex < siblings.length - 1
		? siblings[currentIndex + 1]
		: null;
---

<MainGridLayout title={entry.data.title} description={entry.data.description}>
	<script>
		import("../../scripts/right-sidebar-layout.js");
	</script>

	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4">
		<div class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
			<!-- 返回知识库 -->
			<a
				href="/wiki/"
				class="inline-flex items-center gap-1 text-sm text-black/50 dark:text-white/50 hover:text-(--primary) transition-colors mb-4"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
				</svg>
				返回知识库
			</a>

			<!-- 标题 -->
			<h1 class="text-3xl md:text-[2.25rem]/[2.75rem] font-bold text-black/90 dark:text-white/90 mb-3">
				{entry.data.title}
			</h1>

			<!-- 元信息 -->
			<div class="flex flex-wrap items-center gap-3 mb-6 pb-4 border-(--line-divider) border-dashed border-b">
				<span class="px-2 py-1 text-xs rounded-md bg-(--primary)/10 text-(--primary) font-medium">
					{entry.data.category || "其他"}
				</span>
				{
					(entry.data.tags || []).map((tag) => (
						<span class="px-2 py-1 text-xs rounded-md bg-(--btn-regular-bg) text-black/60 dark:text-white/60 font-medium">
							{tag}
						</span>
					))
				}
				<span class="ml-auto text-xs text-black/40 dark:text-white/40">
					更新于 {formatDateToYYYYMMDD(entry.data.updated)}
				</span>
			</div>

			<!-- 正文 -->
			<Markdown class="mb-6 markdown-content">
				<Content />
			</Markdown>

			<!-- 同分类条目导航 -->
			{
				siblings.length > 1 && (
					<div class="mt-8 pt-4 border-(--line-divider) border-t">
						<p class="text-sm text-black/40 dark:text-white/40 mb-3">
							同分类 · {entry.data.category || "其他"}
						</p>
						<div class="flex flex-col gap-2">
							{
								siblings.map((sibling) => (
									<a
										href={`/wiki/${sibling.id.replace(/\.(md|mdx)$/, "")}/`}
										class:list={[
											"text-sm px-3 py-2 rounded-lg transition-all",
											sibling.id === entry.id
												? "bg-(--primary)/10 text-(--primary) font-medium"
												: "text-black/60 dark:text-white/60 hover:bg-(--btn-regular-bg) hover:text-(--primary)",
										]}
									>
										{sibling.data.title}
									</a>
								))
							}
						</div>
					</div>
				)
			}
		</div>
	</div>
</MainGridLayout>
