---
interface Props {
  src: string;
  title?: string;
  height?: number;
}

// At build time, read the .excalidraw file and embed it as base64
// so no CORS or external fetch is needed at runtime.
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

const { src, title = "Excalidraw 示意图", height = 480 } = Astro.props;

let embedUrl = "";
let errorMsg = "";

try {
  const projectRoot = process.cwd();
  // Resolve the file path: src is like "/excalidraw/scenes/diagram.excalidraw"
  const cleanSrc = src.replace(/^\//, "");
  const filePath = resolve(projectRoot, "public", cleanSrc);
  const content = readFileSync(filePath, "utf-8");

  // Validate it looks like a valid excalidraw JSON
  let parsed: unknown;
  try {
    parsed = JSON.parse(content);
  } catch {
    throw new Error(`文件不是有效的 JSON: ${src}`);
  }

  if (
    typeof parsed !== "object" ||
    parsed === null ||
    !("elements" in (parsed as Record<string, unknown>))
  ) {
    throw new Error(`文件缺少 excalidraw 必需的 "elements" 字段: ${src}`);
  }

  // Base64 encode and URL-encode for the iframe src
  // excalidraw.com's #json= parameter accepts base64-encoded scene JSON
  const base64 = Buffer.from(content, "utf-8").toString("base64");
  const encoded = encodeURIComponent(base64);
  embedUrl = `https://excalidraw.com/#json=${encoded}&embed=1`;
} catch (e) {
  errorMsg = e instanceof Error ? e.message : String(e);
  console.error(`[ExcalidrawViewer] ${errorMsg}`);
}
---

{
  embedUrl ? (
    <div
      class="not-content my-6 overflow-hidden rounded-xl border border-(--border-color) shadow-sm"
    >
      <iframe
        src={embedUrl}
        title={title}
        width="100%"
        height={height}
        style="border: none; display: block;"
        loading="lazy"
        allow="clipboard-read; clipboard-write"
        referrerpolicy="no-referrer"
      >
      </iframe>
      <div
        class="flex items-center justify-between px-4 py-2 text-xs text-(--text-secondary) border-t border-(--border-color)"
      >
        <span class="truncate">{title}</span>
        <a
          href={src}
          target="_blank"
          class="shrink-0 hover:underline transition-colors"
        >
          在 Excalidraw 中编辑 ↗
        </a>
      </div>
    </div>
  ) : (
    <div
      class="not-content my-6 rounded-xl border border-(--border-color) bg-(--bg-secondary)/30 px-5 py-6 text-center text-sm text-(--text-secondary)"
    >
      <div class="mb-2 text-2xl opacity-50">✏️</div>
      <p>Excalidraw 文件加载失败</p>
      {errorMsg && (
        <p class="mt-1 text-xs opacity-60 font-mono">{errorMsg}</p>
      )}
      <p class="mt-2">
        请确认文件路径正确：
        <code class="rounded bg-(--bg-code) px-1.5 py-0.5 text-xs font-mono">
          {src}
        </code>
      </p>
    </div>
  )
}
