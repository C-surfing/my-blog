---
interface Props {
  src: string;
  title?: string;
  height?: number;
  editUrl?: string;
}

// ExcalidrawViewer.astro
// Embeds interactive Excalidraw diagrams in blog posts.
// Uses excalidraw.com's embed mode — requires internet.
// .excalidraw files must have CORS headers (added via public/_headers).

import { readFileSync } from "node:fs";
import { resolve } from "node:path";

const {
  src,
  title = "Excalidraw 示意图",
  height = 480,
  editUrl,
} = Astro.props;

// Build the full public URL for the .excalidraw file
const siteOrigin = Astro.site
  ? String(Astro.site).replace(/\/$/, "")
  : `${Astro.url.protocol}//${Astro.url.host}`;
const fileUrl = `${siteOrigin}${src}`;

// Validate the file exists at build time
let fileError = "";
let fileOk = false;
try {
  const projectRoot = process.cwd();
  const cleanSrc = src.replace(/^\//, "");
  const filePath = resolve(projectRoot, "public", cleanSrc);
  const content = readFileSync(filePath, "utf-8");
  const parsed = JSON.parse(content);
  if (
    typeof parsed === "object" &&
    parsed !== null &&
    "elements" in parsed
  ) {
    fileOk = true;
  } else {
    fileError = "文件格式无效：缺少 elements 字段";
  }
} catch (e) {
  fileError = e instanceof Error ? e.message : String(e);
}

// excalidraw.com embed URL — passes the file URL, which it fetches via AJAX
// CORS is handled by public/_headers for /excalidraw/*
const embedUrl = fileOk
  ? `https://excalidraw.com/#json=${encodeURIComponent(fileUrl)}&embed=1`
  : "";
---

{
  embedUrl ? (
    <div
      class="not-content my-6 overflow-hidden rounded-xl border border-(--border-color) shadow-sm"
    >
      <iframe
        src={embedUrl}
        title={title}
        width="100%"
        height={height}
        style="border: none; display: block;"
        loading="lazy"
        allow="clipboard-read; clipboard-write"
        referrerpolicy="no-referrer"
      >
      </iframe>
      <div
        class="flex items-center justify-between gap-2 px-4 py-2 text-xs text-(--text-secondary) border-t border-(--border-color)"
      >
        <span class="truncate">{title}</span>
        <div class="flex shrink-0 gap-3">
          {editUrl && (
            <a
              href={editUrl}
              target="_blank"
              class="hover:underline transition-colors"
            >
              在 Excalidraw 中编辑 ↗
            </a>
          )}
          <a
            href={`https://excalidraw.com/#json=${encodeURIComponent(fileUrl)}`}
            target="_blank"
            class="hover:underline transition-colors"
          >
            新窗口打开
          </a>
        </div>
      </div>
    </div>
  ) : (
    <div
      class="not-content my-6 rounded-xl border border-(--border-color) bg-(--bg-secondary)/30 px-5 py-6 text-center text-sm text-(--text-secondary)"
    >
      <div class="mb-2 text-2xl opacity-50">✏️</div>
      <p>Excalidraw 文件加载失败</p>
      {fileError && (
        <p class="mt-1 text-xs opacity-60 font-mono">{fileError}</p>
      )}
      <p class="mt-2">
        请确认文件路径正确：
        <code class="rounded bg-(--bg-code) px-1.5 py-0.5 text-xs font-mono">
          {src}
        </code>
      </p>
    </div>
  )
}
